[Unit]
Description=续期 VPN 管理 Web API 的指定 IP 证书
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/vpn-manager/renew_web_certificate.py --cert-name vpn-manager-web-ip --address PUBLIC_IP --bind 0.0.0.0 --certificate-directory /etc/letsencrypt/live/vpn-manager-web-ip --certbot-root /etc/letsencrypt --web-bind 127.0.0.1 --web-port 8443
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/letsencrypt /etc/vpn-manager

[Install]
WantedBy=multi-user.target
